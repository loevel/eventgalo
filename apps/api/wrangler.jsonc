{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventgalo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eventgalo-db",
      "database_id": "9f46ba11-ca0f-445c-9abf-be69b5be81a2"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2daef69c33a5411db488daf6417b5c17"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "eventgalo-media"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "EVENT_DO", "class_name": "EventDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventDO"] }],
  "triggers": { "crons": ["0 4 * * *", "0 * * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "WEB_BASE_URL": "https://eventgalo.com",
    "API_BASE_URL": "https://eventgalo-api.davechendjou.workers.dev",
    "ENVIRONMENT": "production",
    "EMAIL_FROM": "EventGalo <billetterie@eventgalo.com>"
  },
  "env": {
    "staging": {
      "name": "eventgalo-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "eventgalo-db-staging",
          "database_id": "40d1720e-c4c8-476b-b567-091e8b6a2ff9"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "d5ecacf2e1af4a9bba16076c0719c71c"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "eventgalo-media-staging"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "EVENT_DO", "class_name": "EventDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventDO"] }],
      "triggers": { "crons": ["0 4 * * *", "0 * * * *"] },
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "WEB_BASE_URL": "https://eventgalo-web-staging.davechendjou.workers.dev",
        "API_BASE_URL": "https://eventgalo-api-staging.davechendjou.workers.dev",
        "ENVIRONMENT": "staging",
        "EMAIL_FROM": "EventGalo (staging) <billetterie-staging@eventgalo.com>"
      }
    }
  }
}
