{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eventgalo-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Custom domains (eventgalo.com, www.eventgalo.com) are attached via the
  // Cloudflare dashboard: the CI token lacks zone-level Workers Routes access.
  "env": {
    "staging": {
      "name": "eventgalo-web-staging",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": { "enabled": true }
    }
  }
}
